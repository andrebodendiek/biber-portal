# ---------- Biber-Portal: Umgebungsvariablen ----------
# In CapRover unter "App Configs → Environmental Variables" eintragen.

NODE_ENV=production
# Öffentliche Adresse des Portals (ohne Schrägstrich am Ende)
BASE_URL=https://biber.example.de

# IServ der Schule (Issuer, ohne Pfad)
ISERV_URL=https://ihre-iserv-domain.de
# Aus IServ: Verwaltung → System → Single-Sign-On → OAuth-Client
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional (Standardwerte):
# OIDC_SCOPE=openid profile email iserv:groups
# OIDC_ACCOUNT_CLAIM=preferred_username
# OIDC_TOKEN_AUTH_METHOD=            # leer = automatisch (client_secret_basic bevorzugt)
# OIDC_PKCE=true

# IServ-Gruppe(n) der Lehrkräfte für die Gruppenlisten (Kürzel oder Name)
# TEACHER_GROUPS=lehrende

# IServ-Accounts mit Zugriff auf die Verwaltung (kommagetrennt)
ADMIN_ACCOUNTS=andre.bodendiek

# Zufällige Geheimnisse, je mind. 32 Zeichen:  openssl rand -base64 48
SESSION_SECRET=
# ACHTUNG: DATA_KEY nie ändern, sonst sind die gespeicherten Zugangsdaten nicht mehr lesbar
DATA_KEY=

# Anzeige
SCHOOL_NAME=Johann-Beckmann-Gymnasium Hoya
IMPRESSUM_URL=
DATENSCHUTZ_URL=

# Hinter CapRover/nginx: Anzahl vertrauenswürdiger Proxys
TRUST_PROXY=1

# ---------- Nur lokale Entwicklung ----------
# NODE_ENV=development
# BASE_URL=http://localhost:3000
# ISERV_URL=http://localhost:4000      # npm run mock-iserv
# OIDC_CLIENT_ID=biber-portal
# OIDC_CLIENT_SECRET=dev-secret
# DEV_LOGIN=1
